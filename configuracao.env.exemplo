# Configuração do app de finanças
# 1) Faça uma cópia deste arquivo com o nome:  configuracao.env
# 2) Preencha os valores abaixo (o passo a passo está no LEIA-ME.md)
# 3) NUNCA mande este arquivo para ninguém nem coloque no GitHub: ele é a chave dos seus dados.

# Client ID da sua aplicação no Dashboard da Pluggy
CLIENT_ID=cole-aqui-o-client-id

# Client Secret (começa com pluggy_sk_). Ele só aparece uma vez quando você gera!
CLIENT_SECRET=cole-aqui-o-client-secret

# O identificador de cada banco conectado (item id), separados por vírgula.
# Exemplo: ITEM_IDS=1a2b3c4d-....,5e6f7a8b-....
ITEM_IDS=cole-aqui-os-item-ids

# Porta do app no navegador (não precisa mexer)
PORTA=3737
